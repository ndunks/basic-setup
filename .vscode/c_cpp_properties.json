{
    "configurations": [
        {
            "name": "XtensaEspIdf",
            "includePath": [
                "${workspaceFolder}/main/include",
                "${workspaceFolder}/components/*/include",
                "${workspaceFolder}/build/include",
                "~/app/xtensa-lx106-elf/include",
                "~/app/ESP8266_RTOS_SDK/components/*/include",
                "~/app/ESP8266_RTOS_SDK/components/console",
                "~/app/ESP8266_RTOS_SDK/components/freertos/include/freertos",
                "~/app/ESP8266_RTOS_SDK/components/freertos/include/freertos/private",
                "~/app/ESP8266_RTOS_SDK/components/freertos/port/esp8266/include",
                "~/app/ESP8266_RTOS_SDK/components/freertos/port/esp8266/include/freertos",
                "~/app/ESP8266_RTOS_SDK/components/heap/port/esp8266/include",
                "~/app/ESP8266_RTOS_SDK/components/lwip/include/apps",
                "~/app/ESP8266_RTOS_SDK/components/lwip/include/apps/sntp",
                "~/app/ESP8266_RTOS_SDK/components/lwip/lwip/src/include",
                "~/app/ESP8266_RTOS_SDK/components/lwip/port/esp8266/include",
                "~/app/ESP8266_RTOS_SDK/components/lwip/port/esp8266/include/arch",
                "~/app/ESP8266_RTOS_SDK/components/newlib/platform_include"
            ],
            "defines": [
                "__ESP_FILE__=\"dummy.c\""
            ],
            "compilerPath": "~/app/xtensa-lx106-elf/bin/xtensa-lx106-elf-gcc",
            "cStandard": "gnu11",
            "cppStandard": "gnu++11",
            "intelliSenseMode": "linux-gcc-arm"
        }
    ],
    "version": 4
}