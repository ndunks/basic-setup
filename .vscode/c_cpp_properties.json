{
    "configurations": [
        {
            "name": "XtensaEspIdf",
            "includePath": [
                "${workspaceFolder}/main/include",
                "${workspaceFolder}/components/*/include",
                "${workspaceFolder}/build/include",
                "/data/apps/esp-sdk/xtensa-lx106-elf/include",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/*/include",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/console",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/freertos/include/freertos",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/freertos/include/freertos/private",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/freertos/port/esp8266/include",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/freertos/port/esp8266/include/freertos",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/heap/port/esp8266/include",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/lwip/include/apps",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/lwip/include/apps/sntp",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/lwip/lwip/src/include",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/lwip/port/esp8266/include",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/lwip/port/esp8266/include/arch",
                "/data/apps/esp-sdk/ESP8266_RTOS_SDK/components/newlib/platform_include"
            ],
            "defines": [
                "__ESP_FILE__=\"dummy.c\""
            ],
            "compilerPath": "/data/apps/esp-sdk/bin/xtensa-lx106-elf-gcc",
            "cStandard": "c11",
            "cppStandard": "gnu++11",
            "intelliSenseMode": "${default}"
        }
    ],
    "version": 4
}